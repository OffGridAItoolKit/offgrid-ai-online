# OffGrid AI ToolKit Online - Environment Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL Database (required for license keys, usage limits, and admin tools)
# Do not commit real database URLs.
DATABASE_URL=postgresql://user:password@host:5432/database

# License Session Signing (required)
# Use a long, random, stable value. Changing it invalidates existing sessions.
# Do not commit the real JWT secret.
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Admin API Secret (required for production admin routes)
# ADMIN_SECRET is the server-side production environment variable.
# ADMIN_KEY is only a browser-side admin dashboard variable/header value, not a production env var.
# Do not commit real admin secrets.
ADMIN_SECRET=replace_with_a_long_random_admin_secret

# Optional secondary admin secret for temporary rotation or backup access.
ADMIN_SECRET_BACKUP=

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration (comma-separated list of allowed origins)
# For production, set to your domain: https://offgridtoolkit.ai
ALLOWED_ORIGINS=http://localhost:3000,https://offgridtoolkit.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Anonymous app cost controls (daily, UTC)
ANON_DAILY_PROMPT_LIMIT=100
ANON_DAILY_IMAGE_LIMIT=6
GLOBAL_DAILY_IMAGE_LIMIT=100
IMAGE_BURST_LIMIT=3

# Use a stable random secret so anonymous counters remain consistent across restarts.
ANON_USAGE_HASH_SECRET=replace_with_a_long_random_secret

# Optional token required for an active, credit-spending image health probe.
IMAGE_HEALTH_TOKEN=replace_with_a_separate_random_secret

# Optional comma-separated additions to the built-in browser origin allowlist.
CORS_ALLOWED_ORIGINS=
